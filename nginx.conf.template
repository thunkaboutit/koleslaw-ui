server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # This server sits on plain :80 behind Cloudflare and the ALB, so it cannot
    # know the scheme, host or port the client actually used. An absolute
    # Location header would therefore send visitors to http:// on the wrong
    # host; relative ones let the proxy chain keep its own address.
    absolute_redirect off;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 256;

    # Cache static assets aggressively (hashed filenames from Vite)
    #
    # "^~" because a regex location outranks a plain prefix one whatever the
    # order: without it the .html redirect below would reach in here and bounce
    # a hashed asset that happens to be HTML instead of serving it.
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Proxy API and auth requests to the backend
    #
    # These two keep their own locations partly so the trailing-slash rewrite
    # below cannot touch them: the API's MCP endpoint is /v1/mcp/ and needs its
    # slash. "^~" extends that to the .html redirect below, which as a regex
    # would otherwise outrank these prefixes. What a backend URL means is the
    # backend's business, not this server's.
    location ^~ /auth/ {
        resolver 127.0.0.11 valid=10s;
        set $backend ${API_UPSTREAM};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /v1/ {
        resolver 127.0.0.11 valid=10s;
        set $backend ${API_UPSTREAM};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # "/" serves the prerendered home page when the build produced one.
    # index.html stays the NEUTRAL shell that app routes and the 404 response
    # share, so it must not carry the home page's content.
    location = / {
        try_files /home.html /index.html;
    }

    # Every client-side route the app knows. A baked page wins when the build
    # wrote one (blog.html, pricing.html, ...); otherwise the neutral shell
    # boots the route. 200 either way — these URLs exist.
    #
    # The list repeats what src/router/index.ts declares, which nothing here can
    # check: plugins/__tests__/nginx-routes.spec.ts is what keeps the two in step.
    location ~ ^/(blog|pricing|contact|terms|privacy|login|signup|chat|dashboard|keys|profile)$ {
        try_files $uri.html /index.html;
    }

    # The baked pages are files on disk, so every one of them was reachable
    # under its own name too: /pricing.html answered the same 200 as /pricing.
    # A second URL per page is the duplication the canonical tags exist to paper
    # over. Send the file name to the URL the page is served at and there is one.
    #
    # None of this can catch a request try_files has already resolved: only the
    # LAST try_files parameter re-enters location matching, so /pricing still
    # gets pricing.html served in place rather than looping back through here.
    location = /index.html {
        # Not a page: this is the neutral shell nginx hands out for app routes
        # and as the body of every 404. "internal" is what lets it stay both —
        # try_files fallbacks and error_page still reach it, and an exact match
        # outranks the regex below, while a request from outside gets the same
        # 404 as any other URL the site does not serve.
        internal;
    }

    location = /home.html {
        return 301 /;               # the home page's URL is "/"; /home is nothing
    }

    location ~ ^/(.+)\.html$ {
        return 301 /$1;             # /pricing.html -> /pricing
    }

    # Everything else is a real file, a build-time page, or nothing at all.
    #
    # $uri.html is what serves the blog's generated pages (blog/<slug>.html, see
    # plugins/blog-static.ts) with their baked-in title and Open Graph tags.
    # There is deliberately no $uri/ clause: directory indexes would hand out a
    # second, trailing-slash URL for pages that already have a canonical one.
    location / {
        rewrite ^/(.+)/$ /$1 permanent;      # /blog/ -> /blog, relatively
        try_files $uri $uri.html =404;
    }

    # An unknown URL used to fall through to the shell with a 200, which told
    # crawlers the site had an endless supply of duplicate pages and handed
    # browsers HTML in place of a missing script. The shell is still the body,
    # so the SPA boots and renders its own not-found page; without "=200" the
    # status stays 404, which is the part that counts.
    error_page 404 /index.html;
}
